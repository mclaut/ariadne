<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace __HOME__ with your absolute home dir (launchd does not
     expand ~ or env vars), then:
       cp deploy/com.ariadne.sync.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ariadne.sync.plist
     Runs the bounded `ariadnectl maintenance` workflow once a day. It syncs
     edited/deleted memory notes, then consolidates diary entries older than
     24h into durable decisions, gotchas, and reference facts. A failed stage
     receives bounded exponential backoff only when it is transient. Invalid
     model output gets one repair pass, then remains visible as deferred work.
     Append-only activity and logs preserve every outcome. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ariadne.sync</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/.ariadne/bin/ariadnectl</string>
    <string>maintenance</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/.ariadne</string>
  <!-- daily at 04:30; RunAtLoad off so it doesn't fire on every login -->
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string><!-- __ARIADNE_ENV__ --></dict>
  <key>StandardOutPath</key><string>__HOME__/.ariadne/logs/maintenance.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.ariadne/logs/maintenance.log</string>
</dict></plist>
